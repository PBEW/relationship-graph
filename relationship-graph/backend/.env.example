FLASK_ENV=development
FLASK_APP=wsgi.py
SECRET_KEY=change-me-in-production-use-a-random-32-byte-value
JWT_SECRET_KEY=change-me-in-production-use-a-random-32-byte-value
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Seeds the first account (role=super_admin) when migration 5490fe2cba1e runs.
# Only read once, at that migration - manage accounts afterward via the
# admin panel's "ผู้ใช้งาน" tab (super admin only). Dev default: admin / admin.
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=admin
# Alternative to SUPER_ADMIN_PASSWORD: supply a pre-hashed password instead.
# Generate one with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
# SUPER_ADMIN_PASSWORD_HASH=

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/relationship_graph
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/relationship_graph_test

CORS_ORIGINS=http://localhost:5173

MAX_CONTENT_LENGTH_MB=5
ITEMS_PER_PAGE=20
