FLASK_ENV=development
FLASK_APP=wsgi.py
SECRET_KEY=change-me-in-production-use-a-random-32-byte-value
JWT_SECRET_KEY=change-me-in-production-use-a-random-32-byte-value
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Single admin account (no User table in the schema). Dev default: admin / admin.
# Generate a new hash with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:32768:8:1$NwgV6iJNfbaUdsNk$b2a96dc751ef665415875bcaa4e9a1c35402169256c71e1c284895c6baaae31bcf800e20dc669a7445ed73abe80bc1cf2e0c28eae90303875d1288ae2772f6d1

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/relationship_graph
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/relationship_graph_test

CORS_ORIGINS=http://localhost:5173

# Relative paths are resolved against the backend/ directory (not the CWD).
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=5
ITEMS_PER_PAGE=20
